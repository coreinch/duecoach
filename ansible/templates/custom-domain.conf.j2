# Only for Viber/WhatsApp deployments: forwards the two webhook paths to the
# bot and nothing else. Plain HTTP only redirects, so a first request never
# gets served unencrypted.
server {
    listen 80;
    listen [::]:80;
    server_name {{ custom_domain }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name {{ custom_domain }};
    include snippets/ssl-promptbox.conf;

    # The bot answers webhooks immediately and does the slow model work in
    # the background, so the default proxy timeouts are plenty.
    location ~ ^/(viber|whatsapp)$ {
        proxy_pass http://127.0.0.1:{{ app_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Webhook payloads are small; refuse anything large.
        client_max_body_size 1m;
    }

    location / {
        return 404;
    }
}
