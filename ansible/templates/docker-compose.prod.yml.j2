services:
  duecoach:
    image: "{{ ghcr_image }}:{{ image_tag }}"
    restart: unless-stopped
    init: true
    stop_grace_period: 30s
    env_file:
      - .env
    environment:
      DB_PATH: /data/coach.db
      WEB_HOST: 0.0.0.0
    volumes:
      # The database. Named volume: survives redeploys and image updates.
      - data:/data
{% if custom_domain | length > 0 %}
    ports:
      # Only for the Viber/WhatsApp webhooks, and 127.0.0.1-only: the nginx
      # vhost is the one public entry point. A Telegram-only deployment
      # (custom_domain blank) publishes no port at all.
      - "127.0.0.1:{{ app_port }}:8080"
{% endif %}
    # The image's own HEALTHCHECK (GET /healthz inside the container) still
    # applies; this only makes the first result arrive sooner after a deploy.
    healthcheck:
      interval: 15s
      start_period: 20s
    read_only: true
    tmpfs:
      - /tmp
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "5"

volumes:
  data:
