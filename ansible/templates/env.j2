# Rendered by the deploy playbook from extra-vars passed at runtime, never
# committed, mode 0600 on disk (see playbooks/deploy.yml). None of this is
# baked into the Docker image.
TELEGRAM_BOT_TOKEN={{ telegram_bot_token | default('') }}
ALLOWED_USERS={{ allowed_users | default('') }}
LLM_API_KEY={{ llm_api_key | default('') }}
LLM_BASE_URL={{ llm_base_url | default('https://generativelanguage.googleapis.com/v1beta/openai/', true) }}
MINIMAX_API_KEY={{ minimax_api_key | default('') }}
CLOUDFLARE_API_TOKEN={{ cloudflare_api_token | default('') }}
CLOUDFLARE_ACCOUNT_ID={{ cloudflare_account_id | default('') }}
# default(..., true) also replaces an empty value: an unset GitHub secret
# arrives here as "", and an empty LLM_MODEL would override the app's default.
LLM_MODEL={{ llm_model | default('MiniMax-M3', true) }}
# Tried in order when LLM_MODEL fails; empty means no fallback.
LLM_FALLBACK_MODELS={{ llm_fallback_models | default('') }}
VIBER_AUTH_TOKEN={{ viber_auth_token | default('') }}
WHATSAPP_TOKEN={{ whatsapp_token | default('') }}
WHATSAPP_PHONE_NUMBER_ID={{ whatsapp_phone_number_id | default('') }}
WHATSAPP_VERIFY_TOKEN={{ whatsapp_verify_token | default('') }}
WHATSAPP_APP_SECRET={{ whatsapp_app_secret | default('') }}
WHATSAPP_TEMPLATE={{ whatsapp_template | default('') }}
PUBLIC_URL={{ public_url | default('') }}
