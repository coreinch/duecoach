# Rendered by the deploy playbook from extra-vars passed at runtime, never
# committed, mode 0600 on disk (see playbooks/deploy.yml). None of this is
# baked into the Docker image.
TELEGRAM_BOT_TOKEN={{ telegram_bot_token | default('') }}
ALLOWED_USERS={{ allowed_users | default('') }}
LLM_API_KEY={{ llm_api_key }}
LLM_BASE_URL={{ llm_base_url | default('https://api.x.ai/v1', true) }}
# default(..., true) also replaces an empty value: an unset GitHub secret
# arrives here as "", and an empty LLM_MODEL would override the app's default.
LLM_MODEL={{ llm_model | default('grok-4.7', true) }}
# Faster model for the short side jobs (empty: the same as LLM_MODEL).
LLM_SIDE_MODEL={{ llm_side_model | default('') }}
# Model for the verifier that checks each reply (empty: the same as LLM_MODEL). A fast non-thinking-heavy model helps: see the README.
LLM_VERIFIER_MODEL={{ llm_verifier_model | default('') }}
# Google Cloud Text-to-Speech key: replies to voice notes are also spoken (empty: text only).
GOOGLE_TTS_API_KEY={{ google_tts_api_key | default('') }}
# Telegram chat id for the daily digest and alerts about the bot itself (empty: log only).
ADMIN_CHAT_ID={{ admin_chat_id | default('') }}
