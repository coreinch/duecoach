# Copy to .env and fill in. Comments sit on their own lines so both Docker Compose and python-dotenv read this file the same way.

# --- Telegram ----------------------------------------------------------------------------
# Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Who may use the bot, comma-separated Telegram user ids (telegram:123 or just 123).
# Leave empty to open the bot to everyone (everyone then shares your model quota).
ALLOWED_USERS=

# --- Language model (one model, through any OpenAI-compatible API) -------------------
# Default: MiniMax-M3.1-Flash on api.minimax.io; LLM_API_KEY is your MiniMax key. The model must support tool calling.
LLM_API_KEY=
LLM_BASE_URL=https://api.minimax.io/v1
LLM_MODEL=MiniMax-M3.1-Flash
# seconds per model call
# Optional: a different model for the verifier and the evals' judge (default: LLM_MODEL).
# LLM_VERIFIER_MODEL=
# ...at another OpenAI-compatible provider, if you like (default: the coach's URL and key).
# LLM_VERIFIER_BASE_URL=
# LLM_VERIFIER_API_KEY=
LLM_TIMEOUT=60
# model calls in flight at once, across all users
LLM_CONCURRENCY=4

# --- Defaults for new users (each user can change theirs) ----------------------------
# Only a starting guess: check-ins stay off until the user confirms their own timezone.
TIMEZONE=Europe/Athens
# Daily window for check-ins (/morning and /evening).
MORNING_HOUR=9
EVENING_HOUR=20

# --- Check-ins (opt-in per user) ------------------------------------------------------
# Minutes between check-ins when a user turns them on without choosing a number.
CHECKIN_INTERVAL_MINUTES=30
# Back-off for someone who keeps not replying: the gap after 0, 1, 2... unanswered check-ins (never below the user's own interval).
# After the last entry the bot stays quiet until the user writes again.
BACKOFF_MINUTES=30,60,120,240,480,1440,2880,5760,10080,20160
# The evening check-in on this weekday (Mon=0 ... Sun=6) becomes the weekly review; an overdue review also replaces a mid-day pulse.
REVIEW_WEEKDAY=6

# --- Safety -----------------------------------------------------------------------------
# Added to the message sent when someone writes about suicide or self-harm (which always includes 112 and a pointer to professional
# help), e.g. a local helpline: "In Greece you can also call 1018." Check any number before you put it here.
CRISIS_HELP=

# --- Privacy and abuse protection -----------------------------------------------------
# Chat messages older than this many days are deleted (each user's latest 40 are kept). 0 keeps everything.
RETENTION_DAYS=90
# Users who have not written for this many days are deleted with all their data. 0 keeps everyone.
INACTIVE_DELETE_DAYS=365
# A reminder that could not be delivered for this many hours is dropped.
REMINDER_GIVE_UP_HOURS=24
# At most this many messages per user inside the window (seconds).
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW=600

# --- Runtime (docker-compose sets DB_PATH and WEB_HOST for you) -------------------------
# DB_PATH=/data/coach.db
# WEB_HOST=0.0.0.0
# WEB_PORT=8080

# Telegram chat id that gets the daily digest and alerts about the bot (optional; empty: they only go to the log).
# ADMIN_CHAT_ID=
